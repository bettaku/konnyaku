# Required
DATABASE_URL=postgres://konnyaku:konnyaku-dev@127.0.0.1:55432/konnyaku?sslmode=disable
# Origin that browsers use to reach the server (behind nginx/Caddy/Cloudflare Tunnel: the public https origin).
PUBLIC_URL=http://localhost:8080
LISTEN_ADDR=127.0.0.1:8080
# Where Git checkouts are stored (one directory per component ID).
REPOSITORY_ROOT=./data/repositories

# GitHub integration (clone/pull/push over HTTPS, pull request creation)
GITHUB_TOKEN=
# HMAC secret configured on the GitHub webhook (>= 32 characters). Webhook endpoint: POST /webhooks/github
GITHUB_WEBHOOK_SECRET=

# Machine translation: OpenAI-compatible chat completions
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Machine translation: Google Cloud Translation Advanced (v3), uses Application Default Credentials
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Used only by `konnyaku create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
